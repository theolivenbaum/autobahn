<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>Autobahn.Tests</RootNamespace>
        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
        <!-- TUnit runs on Microsoft.Testing.Platform: the test project is its own host. -->
        <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
        <ServerGarbageCollection>true</ServerGarbageCollection>
        <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
        <NoWarn>$(NoWarn);TUnit0055</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="TUnit" Version="1.65.31" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/Autobahn/Autobahn.csproj" />
        <!-- The CLI's argument parsing and scenario discovery are covered here rather than in
             a project of their own: they are a hundred lines each, and a second test project
             would double the build for them. -->
        <ProjectReference Include="../../src/Autobahn.Cli/Autobahn.Cli.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="Assets/**" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

    <!-- The MQTT helper, shipped as its own package for the same reason the others are: a test
         that does not speak MQTT should not carry a broker client. -->

    <PropertyGroup>
        <RootNamespace>Autobahn.Mqtt</RootNamespace>
        <PackageId>Autobahn.Mqtt</PackageId>
        <Title>Autobahn MQTT</Title>
        <Description>MQTT helpers for Autobahn: a pooled client, request/response over topics, and end-to-end delivery latency between a publisher and a consumer scenario.</Description>
        <PackageTags>load-testing;performance-testing;mqtt;iot</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>autobahn-icon.png</PackageIcon>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../../README.md" Pack="true" Visible="false" PackagePath="" />
        <None Include="../../LICENSE" Pack="true" Visible="false" PackagePath="" />
        <None Include="../../assets/autobahn-icon.png" Pack="true" Visible="false" PackagePath="" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="MQTTnet" Version="5.2.0.1603" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Autobahn/Autobahn.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Autobahn.Tests" />
    </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

    <!-- The Autobahn command-line front end, published as a dotnet tool.
         The terminal UI (Terminal.Gui) and the Kestrel-hosted web UI are roadmap items
         (TODO.md, sections 6 and 8); this project currently carries the entry point and
         the argument surface they will hang off. -->

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>Autobahn.Cli</RootNamespace>
        <!-- Not "autobahn": assembly identities are compared case-insensitively, so an
             assembly called that would shadow the engine's own "Autobahn" and every engine
             type would fail to load. The command is still "autobahn" - that is
             ToolCommandName, which has nothing to do with the assembly name. -->
        <AssemblyName>Autobahn.Cli</AssemblyName>

        <PackAsTool>true</PackAsTool>
        <ToolCommandName>autobahn</ToolCommandName>
        <PackageId>Autobahn.Cli</PackageId>
        <Title>Autobahn CLI</Title>
        <Description>Command-line front end for Autobahn: run a load test, watch it live in the terminal, and write its reports.</Description>
        <PackageTags>load-testing;performance-testing;dotnet-tool;cli</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>autobahn-icon.png</PackageIcon>

        <!-- Playwright ships PowerShell helpers under tools/, and NuGet warns once per file
             that it will not auto-run them. It is not meant to: they are there for a person
             to invoke. Nothing to fix, so the warning is silenced rather than tolerated. -->
        <NoWarn>$(NoWarn);NU5111</NoWarn>

        <ServerGarbageCollection>true</ServerGarbageCollection>
        <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../../README.md" Pack="true" Visible="false" PackagePath="" />
        <None Include="../../LICENSE" Pack="true" Visible="false" PackagePath="" />
        <None Include="../../assets/autobahn-icon.png" Pack="true" Visible="false" PackagePath="" />
    </ItemGroup>

    <ItemGroup>
        <!-- Referenced ahead of use: the terminal dashboard is the next thing this project
             grows, and pinning the version now keeps the tool's dependency set decided. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.9.0" />
        <PackageReference Include="Microsoft.Playwright" Version="1.62.0" />
        <PackageReference Include="Terminal.Gui" Version="2.4.17" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Autobahn/Autobahn.csproj" />
        <!-- 'autobahn record' generates HTTP scenario source, which is the HTTP package's
             code generator. The tool carries it; a test project only does if it wants to. -->
        <ProjectReference Include="../Autobahn.Http/Autobahn.Http.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Autobahn.Tests" />
    </ItemGroup>

</Project>

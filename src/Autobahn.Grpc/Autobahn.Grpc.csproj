<Project Sdk="Microsoft.NET.Sdk">

    <!-- The gRPC helper. Thin on purpose: the generated client is the API, and this measures
         calls made through it rather than wrapping it. -->

    <PropertyGroup>
        <RootNamespace>Autobahn.Grpc</RootNamespace>
        <PackageId>Autobahn.Grpc</PackageId>
        <Title>Autobahn gRPC</Title>
        <Description>gRPC helpers for Autobahn: pooled channels, and measured unary and streaming calls through a generated client.</Description>
        <PackageTags>load-testing;performance-testing;grpc</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>autobahn-icon.png</PackageIcon>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../../README.md" Pack="true" Visible="false" PackagePath="" />
        <None Include="../../LICENSE" Pack="true" Visible="false" PackagePath="" />
        <None Include="../../assets/autobahn-icon.png" Pack="true" Visible="false" PackagePath="" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Autobahn/Autobahn.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Autobahn.Tests" />
    </ItemGroup>

</Project>

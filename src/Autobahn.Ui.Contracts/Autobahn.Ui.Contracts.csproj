<Project Sdk="Microsoft.NET.Sdk">

    <!-- Wire DTOs shared by the CLI host and the Tesserae web UI.

         netstandard2.0 is a framework constraint, not a language one: Tesserae and the
         Transpose compiler build against netstandard2.0, so a project the UI references
         has to target it too. LangVersion stays at latest - records, init-only setters
         and file-scoped namespaces are all available. See TODO.md, section 8.

         Multi-targeted: netstandard2.0 for the UI, net10.0 so the host references it
         natively rather than through a compatibility shim. The DTOs are plain either way -
         this is a schema both ends have to agree on, not a place for clever C#. -->

    <PropertyGroup>
        <!-- Cleared explicitly: Directory.Build.props sets TargetFramework for the whole
             repository, and a project that has both is single-targeted by the singular one. -->
        <TargetFramework></TargetFramework>
        <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
        <RootNamespace>Autobahn.Ui.Contracts</RootNamespace>
        <IsPackable>false</IsPackable>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Autobahn.Tests" />
    </ItemGroup>

</Project>
